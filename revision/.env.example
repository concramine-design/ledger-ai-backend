# Mes révisions : configuration.
# installer.bat copie ce fichier en ".env". Colle tes clés dans ".env", jamais ici.
# Le fichier .env reste sur cet ordinateur : ne le partage pas.

# Fournisseur d'IA : auto (Claude d'abord, puis Gemini et Groq en secours si leur clé est remplie),
# claude, gemini, groq, ou mock (démonstration sans clé, contenus factices).
LLM_PROVIDER=auto

# Clé Claude (API Anthropic, payante à l'usage) : https://console.anthropic.com
# Ce n'est PAS l'abonnement claude.ai : il faut un compte API et du crédit.
# Claude lit aussi les photos du cahier.
ANTHROPIC_API_KEY=
# Modèle : claude-opus-5-5 (le plus intelligent, par défaut), claude-sonnet-5-5 (plus rapide,
# deux fois moins cher), claude-haiku-5-5 (très rapide, très bon marché).
CLAUDE_MODEL=claude-opus-5-5
# Profondeur de réflexion : low, medium (par défaut), high.
CLAUDE_EFFORT=medium

# Clé Gemini (gratuite, facultative : sert de secours) : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Clé Groq (facultative, sert de secours) : https://console.groq.com/keys
GROQ_API_KEY=
# "auto" : l'application choisit un modèle disponible.
GROQ_MODEL=auto
GROQ_VISION_MODEL=auto

# Clé YouTube Data API v3 (gratuite) : sert à choisir 3 vidéos par leçon.
# Sur https://console.cloud.google.com : crée un projet, active « YouTube Data API v3 »,
# puis Identifiants > Créer des identifiants > Clé API. Sans clé, il n'y a simplement pas de vidéos.
YOUTUBE_API_KEY=

# Qui prépare les leçons importées : gemini (tout de suite, automatiquement)
# ou claude (la nuit, par l'application Claude branchée avec connecter_claude.bat).
PREPARATION_PAR=gemini
# En mode claude : si Claude n'est pas passé à cette heure-là le matin, la préparation automatique prend le relais.
HEURE_LIMITE_CLAUDE=07:00

# Port local de l'application.
PORT=8765
